# Shopify CLI populates the Shopify credentials and app URL during `npm run dev`.
SHOPIFY_API_KEY=4904dab6d671e8e2789eb47aa6b2b69d
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://your-app-url.example

# Shopify App Pricing / Partner API: create a Partner API client with Manage apps.
# The Partner API is the authority for plan entitlements; plans themselves are configured in the Partner Dashboard.
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
SHOPIFY_APP_GID=gid://shopify/App/your-app-id
SHOPIFY_APP_HANDLE=pricepilot
SHOPIFY_PARTNER_API_VERSION=2026-07

# PostgreSQL connection string, for example:
# For the included local Compose service use:
# postgresql://pricepilot:pricepilot@localhost:5432/pricepilot?schema=public
DATABASE_URL=
